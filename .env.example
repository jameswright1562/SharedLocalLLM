# SharedLocalLLM optional runtime overrides
#
# Copy this file to `.env` (repo root or `backend/.env`) and edit values for
# the local machine. The `.env` file is gitignored; only `.env.example` is
# tracked, so machine-specific paths never get committed.

# EXPERIMENTAL: point the app at an unverified llama-server build (for example
# the Unsloth `glm5next` fork that mainline llama.cpp has not yet merged) while
# leaving the SHA-256-pinned official runtime manifest untouched. The binary in
# this directory is NOT digest-verified against the official release, so it is
# intended for throwaway experiments only. When unset, the app uses only the
# verified pinned binary in `backend/runtime/llama-bin`.
SHAREDLOCALLLM_LLAMA_SERVER_DIR=
