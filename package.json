{
  "name": "shared-local-llm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"*.{json,js,cjs,ts,md,html}\" \".github/**/*.{yml,yaml,md}\" \"docs/**/*.md\" \"public/**/*.{json,md}\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "backend:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-python-backend.ps1",
    "backend:install:llama-server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-llama-server.ps1",
    "backend:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-python-backend.ps1",
    "backend:typecheck": "backend\\.venv\\Scripts\\python.exe -m pyright",
    "backend:test": "backend\\.venv\\Scripts\\python.exe -m pytest backend\\tests -p no:cacheprovider --basetemp backend\\.pytest-tmp",
    "backend:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-python-backend.ps1",
    "tauri": "tauri",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm e2e && pnpm backend:typecheck && pnpm backend:test"
  },
  "dependencies": {
    "@mantine/charts": "^9.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@mantine/spotlight": "^9.5.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-table": "^9.1.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-opener": "~2.5.4",
    "clsx": "^2.1.1",
    "mantine-contextmenu": "^9.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.10.0",
    "jsdom": "30.0.1",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "."
  ]
}
